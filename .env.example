# Only needed to actually send contact form submissions; the site runs without them.
# Read at build time (vite.config.js); must be set in the Netlify build environment
PUBLIC_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=
HCAPTCHA_VERIFY_API=https://api.hcaptcha.com/siteverify
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_RCPT=
SMTP_SUBJECT=New contact form submission
